# ───── Modalità ─────
# false = simulazione (prezzi e wallet veri, trade virtuali). true = SOLDI VERI.
LIVE=false

# Chiave privata di un wallet NUOVO e dedicato al bot (base58 come da Phantom, oppure array JSON).
# Mettici solo i SOL che sei disposto a perdere. Non usare il tuo wallet principale.
PRIVATE_KEY=

# RPC Solana. Quella pubblica limita molto le richieste: usa una RPC privata
# (Helius, QuickNode, Triton…), per esempio https://mainnet.helius-rpc.com/?api-key=LA_TUA_CHIAVE
RPC_URL=https://api.mainnet-beta.solana.com

# File con i wallet da copiare
WHALES_FILE=whales.json

# ───── Capitale ─────
BUDGET_SOL=0.5            # massimo che il bot può avere investito
TRADE_SOL=0.05            # SOL per ogni acquisto
MAX_OPEN_POSITIONS=5
RESERVE_SOL=0.02          # SOL lasciati sempre per le fee
MAX_DAILY_LOSS_SOL=0.15   # oltre questa perdita giornaliera smette di comprare

# ───── Filtri d'ingresso ─────
MIN_WHALE_BUY_SOL=1       # copia solo acquisti della whale da almeno N SOL
MAX_SIGNAL_AGE_SEC=60     # ignora segnali più vecchi
MIN_LIQUIDITY_USD=20000
MIN_MCAP_USD=50000
MAX_MCAP_USD=50000000
MIN_PAIR_AGE_MIN=30       # evita pool appena create (rug frequenti)
MAX_ROUND_TRIP_LOSS_PCT=8 # anti-honeypot: perdita max comprando e rivendendo subito
ALLOW_TOKEN_2022=false
COOLDOWN_MIN=60

# ───── Uscite ─────
STOP_LOSS_PCT=8
TAKE_PROFIT_PCT=60        # 0 = disattivato
TRAILING_ACTIVATE_PCT=25
TRAILING_STOP_PCT=12
MAX_HOLD_MIN=240          # 0 = disattivato
FOLLOW_WHALE_EXIT=true    # vende quando vende la whale copiata

# ───── Esecuzione ─────
SLIPPAGE_BPS=300          # 3%
MAX_PRICE_IMPACT_PCT=3
PRIORITY_FEE_MAX_LAMPORTS=200000

# ───── Ritmo e dashboard ─────
POLL_WHALES_SEC=5
POLL_POSITIONS_SEC=10
PORT=8787
HOST=127.0.0.1
# Obbligatorio se HOST non è 127.0.0.1
DASHBOARD_TOKEN=
